{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "bg",
					"name": "Fundo",
					"color": "#0a0a1a"
				},
				{
					"slug": "surface",
					"name": "Superfície",
					"color": "#14142a"
				},
				{
					"slug": "surface-2",
					"name": "Superfície clara",
					"color": "#1d1d36"
				},
				{
					"slug": "border",
					"name": "Borda",
					"color": "#2b2b4a"
				},
				{
					"slug": "text",
					"name": "Texto",
					"color": "#f5f5fa"
				},
				{
					"slug": "muted",
					"name": "Texto secundário",
					"color": "#a3a3bd"
				},
				{
					"slug": "primary",
					"name": "Violeta",
					"color": "#8b5cf6"
				},
				{
					"slug": "primary-soft",
					"name": "Violeta claro",
					"color": "#a78bfa"
				},
				{
					"slug": "primary-strong",
					"name": "Violeta escuro",
					"color": "#7c3aed"
				},
				{
					"slug": "secondary",
					"name": "Ciano",
					"color": "#22d3ee"
				},
				{
					"slug": "accent",
					"name": "Azul",
					"color": "#38bdf8"
				},
				{
					"slug": "success",
					"name": "Verde",
					"color": "#22c55e"
				},
				{
					"slug": "warning",
					"name": "Âmbar",
					"color": "#f59e0b"
				},
				{
					"slug": "danger",
					"name": "Vermelho",
					"color": "#f43f5e"
				},
				{
					"slug": "white",
					"name": "Branco",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "brand",
					"name": "Galáxia",
					"gradient": "linear-gradient(90deg, #8b5cf6 0%, #22d3ee 100%)"
				},
				{
					"slug": "brand-strong",
					"name": "Galáxia (botões)",
					"gradient": "linear-gradient(90deg, #7c3aed 0%, #2563eb 55%, #0e7490 100%)"
				},
				{
					"slug": "nebula",
					"name": "Nebulosa",
					"gradient": "radial-gradient(80% 120% at 0% 0%, rgba(139, 92, 246, 0.35) 0%, rgba(10, 10, 26, 0) 60%), radial-gradient(70% 100% at 100% 100%, rgba(34, 211, 238, 0.22) 0%, rgba(10, 10, 26, 0) 60%), linear-gradient(180deg, #14142a 0%, #0f0f22 100%)"
				},
				{
					"slug": "deep-space",
					"name": "Espaço profundo",
					"gradient": "linear-gradient(180deg, #0a0a1a 0%, #120f2e 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "clamp(1.75rem, 1.25rem + 2vw, 2.75rem)"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "clamp(2.5rem, 1.75rem + 3vw, 4rem)"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "clamp(3.5rem, 2.25rem + 5vw, 6rem)"
				},
				{
					"slug": "80",
					"name": "8",
					"size": "clamp(4.5rem, 2.5rem + 8vw, 9rem)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, \"Inter Fallback\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monoespaçada",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Muito pequeno",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Pequeno",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Médio",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Grande",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.3125rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra grande",
					"size": "1.75rem",
					"fluid": {
						"min": "1.4rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Título de seção",
					"size": "2.75rem",
					"fluid": {
						"min": "1.9rem",
						"max": "2.875rem"
					}
				},
				{
					"slug": "display",
					"name": "Título principal",
					"size": "4.25rem",
					"fluid": {
						"min": "2.4rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card",
					"name": "Cartão",
					"shadow": "0 24px 50px -24px rgba(0, 0, 0, 0.6)"
				},
				{
					"slug": "glow",
					"name": "Brilho violeta",
					"shadow": "0 30px 80px -30px rgba(139, 92, 246, 0.55)"
				}
			]
		},
		"custom": {
			"radius": {
				"card": "18px",
				"small": "10px",
				"pill": "999px"
			},
			"header": {
				"height": "72px"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-soft)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--secondary)",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--text)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em",
					"textWrap": "balance"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.03em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"button": {
				"color": {
					"gradient": "var(--wp--preset--gradient--brand-strong)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"gradient": "var(--wp--preset--gradient--brand-strong)",
						"text": "var(--wp--preset--color--white)"
					},
					"shadow": "var(--wp--preset--shadow--glow)"
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--secondary)",
						"style": "solid",
						"width": "2px",
						"offset": "3px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--muted)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--text)"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary-soft)"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--secondary)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-excerpt": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				},
				"border": {
					"width": "1px"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--small)",
					"color": "var(--wp--preset--color--border)",
					"width": "1px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"core/details": {
				"border": {
					"color": "var(--wp--preset--color--border)",
					"width": "1px",
					"style": "solid",
					"radius": "var(--wp--custom--radius--card)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"spacing": {
					"padding": {
						"top": "1.1rem",
						"bottom": "1.1rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--card)"
				}
			},
			"core/search": {
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "1.25rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Cabeçalho",
			"area": "header"
		},
		{
			"name": "header-en",
			"title": "Cabeçalho (inglês)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Rodapé",
			"area": "footer"
		},
		{
			"name": "footer-en",
			"title": "Rodapé (inglês)",
			"area": "footer"
		},
		{
			"name": "cta",
			"title": "Chamada final (Vamos conversar)",
			"area": "uncategorized"
		},
		{
			"name": "cta-en",
			"title": "Chamada final (inglês)",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Página de vendas (largura total, sem título)",
			"postTypes": [
				"page"
			]
		}
	]
}
